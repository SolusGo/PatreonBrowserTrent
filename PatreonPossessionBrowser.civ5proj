<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{26C99A7D-D195-4D57-AC09-4626070684FB}</ProjectGuid>
    <Name>Trent - The Patreon Possession Browser</Name>
    <SafeName>Trent - The Patreon Possession Browser</SafeName>
    <Guid>ad32607d-c122-4f6d-a1e1-b18044366f71</Guid>
    <Teaser>Browse a fictional creator feed, save possession clips, and turn enemy units into temporary or permanent hosts.</Teaser>
    <Description>Adds the Possession Browsers, led by Trentrouls. A scripted fictional creator feed supplies clips used to possess visible wartime enemies, body-hop after kills, and evolve a permanent Main Host.</Description>
    <Authors>ThatOneYi</Authors>
    <AssemblyName>PatreonPossessionBrowser</AssemblyName>
    <RootNamespace>PatreonPossessionBrowser</RootNamespace>
    <Civ5Path>C:\Program Files (x86)\Steam\steamapps\common\Sid Meier's Civilization V</Civ5Path>
    <Civ5UserPath>C:\Users\ThatOneYi\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <ModActions>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>Art/PPB_IconAtlases.xml</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/00_PPB_Core.sql</FileName></Action>
      <Action><Set>OnModActivated</Set><Type>UpdateDatabase</Type><FileName>SQL/10_PPB_Text.sql</FileName></Action>
    </ModActions>
    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Patreon Possession Browser Gameplay</Name>
        <Description>Loads the persistent feed, clips, AI, and possession systems.</Description>
        <FileName>Lua/PPBLoader.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Patreon Possession Browser Interface</Name>
        <Description>Displays the fictional creator feed, Saved Clips, hosts, and Body-Hop decisions.</Description>
        <FileName>UI/PPBPatreonPanel.xml</FileName>
      </Content>
    </ModContent>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModDependencies>
      <Association>
        <Type>Mod</Type>
        <Name>(1) Community Patch</Name>
        <Id>d1b6328c-ff44-4b0d-aad7-c657f83610cd</Id>
        <MinVersion>1</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModDependencies>
    <ModReferences />
    <ModBlockers />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
